---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets'; 
import '../styles/style.scss';

// Define types for frontmatter properties
interface Props {
    frontmatter: {
        title: string;
        hero: Array<Record<string, any>>;
        blocks?: Array<Record<string, any>>;
        page_setup?: {
            seo_description?: string;
        };
    };
}

const { frontmatter } = Astro.props;

/* Convert Astro's PascalCase component filenames to kebab-case, matching the CMS block "type" strings,
so the blockComponents() function can map the right component to each block in the CMS page content. */
function toKebabCase(str: string) {
    return str.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
}

const blockModules = import.meta.glob('../components/blocks/*.astro', { eager: true });

const blockComponents = Object.fromEntries(
    Object.entries(blockModules).map(([path, mod]) => {
        const fileName = path.split('/').pop()!.replace('.astro', '');
        const key = toKebabCase(fileName);
        return [key, (mod as any).default];
    })
);

const HeroComponent = blockComponents[frontmatter.hero[0].type];

// Define page metadata variables
const pageTitle = frontmatter.title !== 'Steadyfooted' ? `${frontmatter.title} | Steadyfooted` : frontmatter.title;
const seoMeta = frontmatter.page_setup?.seo_description === 'no-index'
    ? { name: 'robots', content: 'noindex' }
    : { name: 'description', content: frontmatter.page_setup?.seo_description };

console.log(Object.keys(blockComponents));
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <meta {...seoMeta} />
    <Font cssVariable="--font-pacifico" />
    <Font cssVariable="--font-ibm-plex-mono" />
    <!-- Theme Toggle Script -->
    <script is:inline>
        const theme = (() => {
            const localStorageTheme = localStorage?.getItem("theme") ?? '';
            if (['dark', 'light'].includes(localStorageTheme)) {
            return localStorageTheme;
            }
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
            }
            return 'light';
        })();

        if (theme === 'light') {
            document.documentElement.classList.remove('dark');
        } else {
            document.documentElement.classList.add('dark');
        }

        window.localStorage.setItem('theme', theme);

        document.addEventListener('DOMContentLoaded', () => {
            const handleToggleClick = () => {
                const element = document.documentElement;
                element.classList.toggle("dark");
    
                const isDark = element.classList.contains("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
            }
    
            document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
        })
    </script>
</head>
<body>
    <Header />
    <main>
        <slot />
        <p>try this out</p>
        {HeroComponent && <HeroComponent block={frontmatter.hero[0]} />}

        {frontmatter.blocks?.map((block) => {
            const BlockComponent = blockComponents[block.type];
            if (!BlockComponent) {
                throw new Error(`No matching component for block type: "${block.type}"`);
            }
            return <BlockComponent block={block} />;
        })}
    </main>
    <Footer />
    <script>
        import "../scripts/main.js";
    </script>
</body>
</html>