<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}{% if title != "Steadyfooted"%} | Steadyfooted{%  endif %}</title>
    {% if seo_description == "no-index" %}
        <meta name="robots" content="noindex">
    {% else %}
        <meta name="description" content="{{ page_setup.seo_description }}">
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.min.css">
</head>
<body>
    <script>
        // Check for saved preference first, then system preference, then default to dark
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        // Apply light mode if:
        // 1. User explicitly chose light, OR
        // 2. No saved preference AND system prefers light
        if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
            document.body.classList.add('light');
        }
    </script>
    <header>
        <div class="wrap flex flex-wrap">
            <a href="/">Steadyfooted</a>
            <div class="flex flex-wrap">
                <div class="icon-container">
                    <button class="icon-btn flex just-center" id="menu-toggle" aria-label="Toggle menu">
                        <span class="fa-solid fa-bars flex just-center"></span>
                    </button>
                </div>
                <nav class="nav">
                    <ul>
                        {% for item in header_menu.menu.items %}
                            <li>
                                <a href="{{ item.url }}" {% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                                    {{ item.link_text }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
            <div class="icon-container">
                <button class="icon-btn flex just-center" id="dark-mode-toggle" aria-label="Toggle dark mode">
                    <span class="fa-solid fa-sun flex just-center"></span>
                </button>
            </div>
        </div>
    </header>
    <main>
                {% # Hero Section %}
        {% assign heroBlock = hero[0] %}
        {%- capture hero_template -%}blocks/{{ heroBlock.type }}.liquid{%- endcapture -%}
        {% include hero_template, block: heroBlock %}
        
        {% # Loop through blocks; build fails if block.type is missing or file doesn't exist %}
        {% for block in blocks %}
            {%- capture template_path -%}blocks/{{ block.type }}.liquid{%- endcapture -%}
            {% render template_path, block: block %}
        {% endfor %}
    </main>
    <footer>
        <div class="wrap flex f-wrap">
            <nav>
                <ul>
                {% for item in footer_menu.menu.items %}
                    <li>
                    <a href="{{ item.url }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                        {{ item.link_text }}
                    </a>
                    </li>
                {% endfor %}
                </ul>
            </nav>
            <p>&copy; 2025 Steadyfooted. All rights reserved.</p>
        </div>
    </footer>
    <script src="https://kit.fontawesome.com/6718c3b0d7.js" crossorigin="anonymous"></script>
    <script src="/js/main.js"></script>
</body>
</html>