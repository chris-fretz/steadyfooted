---
import { menu } from '../data/footer-menu.json';
import SocialIcons from '../components/SocialIcons.astro';
---
 <footer class="py-30">
    <div class="wrap flex flex-col flex-wrap align-center gap-40">
        <a class="logo-link" href="/">Steadyfooted</a>
        <nav class="nav">
            <ul>
            {menu.items.map((item) => (
                <li>
                    <a
                        href={item.url}
                        target={item.new_tab ? '_blank' : undefined}
                        rel={item.new_tab ? 'noopener noreferrer' : undefined}
                    >
                        {item.link_text}
                    </a>
                </li>
            ))}
            </ul>
        </nav>
        <SocialIcons />
        <p class="text-center">&copy; <span id="year"></span> Steadyfooted. All rights reserved.</p>
    </div>
</footer>