---
import { renderMarkdown } from '../../utils/helpers.js';
const { block } = Astro.props;
const subheading = block.subheading ? renderMarkdown(block.subheading) : null;
---

<section class="hero simple-hero">
    <div class="wrap">
        <div class="centered">
            <h1>{block.heading}</h1>
            {subheading && <div class="mx-800" set:html={subheading} />}
        </div>
    </div>
</section>