---
import { renderMarkdown } from '../../utils/helpers.js';
interface Item {
    copy: string;
    circular: string;
    image: string;
    alt_text: string;
}

interface Props {
    block: {
        orientation: string;
        sections: Item[];
    }
}

const { block } = Astro.props;
---

<div class={`alt-content-wrap ${block.orientation}`}>
    {block.sections.map((item) => {
        const copy = item.copy ? renderMarkdown(item.copy) : null;
        return (
            <section class="block">
                <div class="wrap flex">
                    {copy && <div set:html={copy} />}
                    <div>
                        <img class={item.circular ? "circular" : undefined}
                            src={item.image} 
                            alt={item.alt_text}
                            width="520" 
                        />
                    </div>
                </div>
            </section>
        )
    })}
</div>